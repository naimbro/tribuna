rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Todos entran con Google (jugar.html y la pantalla del profesor). Sin `email_verified`
    // cualquiera que fabrique una cuenta con el correo de un profe podría crear salas.
    function conSesion() { return request.auth != null && request.auth.token.email_verified == true; }
    // Quién puede crear salas: el administrador o un correo en la colección `profesores`.
    function esProfesorAutorizado() {
      return conSesion() && (
        request.auth.token.email == 'naim.bro@gmail.com' ||
        exists(/databases/$(database)/documents/profesores/$(request.auth.token.email.lower())));
    }
    // Los helpers reciben el código: una función definida fuera del match no ve {codigo}.
    function sala(codigo) { return get(/databases/$(database)/documents/salas/$(codigo)); }
    function esProfe(codigo) { return conSesion() && sala(codigo).data.profeUid == request.auth.uid; }
    function jugador(codigo) { return get(/databases/$(database)/documents/salas/$(codigo)/jugadores/$(request.auth.uid)); }
    function esJugador(codigo) { return exists(/databases/$(database)/documents/salas/$(codigo)/jugadores/$(request.auth.uid)); }

    // Clase con personajes (semana 308): el cupo de cada personaje se hace cumplir aquí, no en la
    // pantalla del profesor. salas/{codigo}/cupos/{g} guarda los uid inscritos en el personaje g; el
    // alumno cambia su `grupo` y su lugar en el cupo en una sola escritura en lote, amarradas con
    // getAfter. Dos que tocan el último lugar a la vez: Firestore serializa las dos escrituras sobre
    // el mismo documento y la segunda ya encuentra el cupo lleno.
    function conPersonajes(codigo) { return sala(codigo).data.get('personajes', null) != null; }
    function inscripcionAbierta(codigo) { return sala(codigo).data.get('inscripcion', '') == 'abierta'; }
    function cupoDoc(codigo, g) { return /databases/$(database)/documents/salas/$(codigo)/cupos/$(string(g)); }
    function inscritoDespues(codigo, g) {
      return existsAfter(cupoDoc(codigo, g)) && request.auth.uid in getAfter(cupoDoc(codigo, g)).data.miembros;
    }
    // Elegir o cambiar de personaje: solo con la inscripción abierta, entrando al cupo del nuevo y
    // saliendo del anterior en el mismo lote.
    function cambioDePersonaje(codigo, antes, despues) {
      return antes == despues
        || (inscripcionAbierta(codigo)
            && (despues == 0 || inscritoDespues(codigo, despues))
            && (antes == 0 || !inscritoDespues(codigo, antes)));
    }

    // Lista de profesores con permiso para crear salas: un documento por correo (en
    // minúsculas), p. ej. profesores/ayudante@uai.cl con {nombre: "..."}. Solo la edita el admin.
    match /profesores/{email} {
      allow read: if conSesion() && request.auth.token.email.lower() == email;
      allow write: if conSesion() && request.auth.token.email == 'naim.bro@gmail.com';
    }

    match /salas/{codigo} {
      // Cualquiera con el código lee la sala (alumnos entran con sesión anónima).
      allow read: if conSesion();
      // Solo la pantalla que la creó la escribe. Anónimo, pero el uid persiste en ese navegador.
      allow create: if esProfesorAutorizado() && request.resource.data.profeUid == request.auth.uid;
      allow update, delete: if esProfe(codigo);

      match /privado/{doc} {
        allow read, write: if esProfe(codigo);
      }

      match /jugadores/{uid} {
        allow read: if conSesion();
        // El alumno escribe su propio documento. Su grupo (rotación) solo cambia mientras la
        // sala está en la portada o si todavía no eligió (0). El profesor puede moverlo.
        // Con personajes, el grupo cambia solo junto con su lugar en el cupo (cambioDePersonaje).
        allow write: if (conSesion() && uid == request.auth.uid
            && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 40
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.get('equipo', '') in ['', 'A', 'B', 'P']
            && (!('grupo' in request.resource.data)
                || (request.resource.data.grupo is int && request.resource.data.grupo >= 0 && request.resource.data.grupo <= 10
                    && ((!conPersonajes(codigo)
                         && (resource == null || resource.data.get('grupo', 0) == 0
                             || resource.data.get('grupo', 0) == request.resource.data.grupo
                             || sala(codigo).data.get('etapa', null) == 'portada'))
                        || (conPersonajes(codigo) && resource == null
                            && cambioDePersonaje(codigo, 0, request.resource.data.grupo))
                        || (conPersonajes(codigo) && resource != null
                            && cambioDePersonaje(codigo, resource.data.get('grupo', 0), request.resource.data.grupo))))))
          || (esProfe(codigo) && request.resource.data.get('grupo', 0) is int
              && request.resource.data.get('grupo', 0) >= 0 && request.resource.data.get('grupo', 0) <= 10);
      }

      // El cupo de cada personaje (miembros: {uid: true}). El profesor crea los documentos con la
      // sala y los corrige al mover a alguien; cada alumno solo se agrega o se quita a sí mismo, con
      // la inscripción abierta, y entra solo si queda lugar. Salir siempre se puede.
      match /cupos/{g} {
        allow read: if conSesion();
        allow create, delete: if esProfe(codigo);
        allow update: if esProfe(codigo)
          || (conSesion() && esJugador(codigo) && inscripcionAbierta(codigo)
              && request.resource.data.keys().hasOnly(['miembros'])
              && request.resource.data.miembros.diff(resource.data.miembros).affectedKeys().hasOnly([request.auth.uid])
              // estar en este cupo equivale a quedar con este grupo, en el mismo lote
              && (request.auth.uid in request.resource.data.miembros)
                 == (getAfter(/databases/$(database)/documents/salas/$(codigo)/jugadores/$(request.auth.uid)).data.grupo == int(g))
              && (!(request.auth.uid in request.resource.data.miembros)
                  || request.resource.data.miembros.size() <= sala(codigo).data.cupo));
      }

      // Una intervención por alumno y ronda (se sobreescribe cada ronda). Solo su dueño la
      // escribe, solo por su bancada y con la ronda abierta. La leen su bancada y el profesor:
      // la bancada rival no ve los borradores (se escribe a ciegas).
      match /intervenciones/{uid} {
        allow read: if esProfe(codigo) || (conSesion() && esJugador(codigo)
          && jugador(codigo).data.equipo == resource.data.equipo);
        allow write: if conSesion() && uid == request.auth.uid
          && esJugador(codigo)
          && request.resource.data.equipo == jugador(codigo).data.equipo
          && request.resource.data.equipo in ['A', 'B']
          && sala(codigo).data.fase == 'abierta'
          && request.resource.data.texto is string && request.resource.data.texto.size() <= 4000;
      }

      // La conversación: un solo hilo. La leen todos los de la sala. Un alumno de una bancada
      // publica solo como sí mismo, por su bancada y con el tramo abierto; lo demás (moderadora,
      // relator, resultados) lo publica la pantalla del profesor. Nadie edita ni borra salvo él.
      match /mensajes/{id} {
        allow read: if esProfe(codigo) || (conSesion() && esJugador(codigo));
        allow create: if esProfe(codigo)
          // modo clásico (salas antiguas)
          || (conSesion() && esJugador(codigo)
            && sala(codigo).data.get('modo', '') != 'rotacion'
            && request.resource.data.tipo == 'alumno'
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.equipo == jugador(codigo).data.equipo
            && request.resource.data.equipo in ['A', 'B']
            && sala(codigo).data.fase == 'abierta'
            && request.resource.data.texto is string
            && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 1500)
          // rotación: solo los dos grupos llamados, cada uno por su lado, en el debate en curso
          || (conSesion() && esJugador(codigo)
            && sala(codigo).data.get('modo', '') == 'rotacion'
            && request.resource.data.tipo == 'alumno'
            && request.resource.data.uid == request.auth.uid
            && sala(codigo).data.fase == 'abierta'
            && request.resource.data.debate == sala(codigo).data.debate.n
            && request.resource.data.grupo == jugador(codigo).data.grupo
            && ((request.resource.data.equipo == 'A' && jugador(codigo).data.grupo == sala(codigo).data.debate.A)
                || (request.resource.data.equipo == 'B' && jugador(codigo).data.grupo == sala(codigo).data.debate.B))
            && request.resource.data.texto is string
            && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 1500);
        allow update, delete: if esProfe(codigo);
      }

      // Feedback del juego (al terminar, en el teléfono): nota 1–7 o null y un comentario corto.
      // Lo escribe cada alumno sobre sí mismo; lo leen él y el profesor de la sala (en el panel,
      // no frente al curso). No es anónimo: el id es su uid.
      match /feedback/{uid} {
        allow read: if esProfe(codigo) || (conSesion() && uid == request.auth.uid);
        allow write: if conSesion() && uid == request.auth.uid && esJugador(codigo)
          && (request.resource.data.nota == null
              || (request.resource.data.nota is int && request.resource.data.nota >= 1 && request.resource.data.nota <= 7))
          && request.resource.data.comentario is string && request.resource.data.comentario.size() <= 300;
      }

      // El público: cada alumno que no debate guarda su posición frente a la moción (−100…+100).
      // La escribe solo él, solo si entró como público; la lee él y el profesor (nadie más ve
      // cómo votó cada uno).
      match /publico/{uid} {
        allow read: if esProfe(codigo) || (conSesion() && uid == request.auth.uid);
        allow write: if conSesion() && uid == request.auth.uid
          && esJugador(codigo) && jugador(codigo).data.equipo == 'P'
          && request.resource.data.pos is number
          && request.resource.data.pos >= -100 && request.resource.data.pos <= 100;
      }

      // Telemetría de escritura (antitrampa): cada alumno registra cómo escribió sus mensajes; solo
      // la lee el profesor de la sala. Nunca entra en un puntaje.
      match /telemetria/{id} {
        allow read: if esProfe(codigo);
        allow create: if conSesion() && esJugador(codigo) && request.resource.data.uid == request.auth.uid
          && request.resource.data.largoFinal is int && request.resource.data.largoFinal <= 2000;
      }

      // Brújula corta: la respuesta de cada alumno (posición y campo). La escribe el propio alumno
      // mientras la brújula está abierta (al comienzo, para quien llega tarde, y al repetirla al
      // cierre). La leen él y el profesor; el mapa público va sin uid.
      match /brujula/{uid} {
        allow read: if esProfe(codigo) || (conSesion() && uid == request.auth.uid);
        allow write: if conSesion() && uid == request.auth.uid && esJugador(codigo)
          && sala(codigo).data.get('brujula', {}).get('fase', '') in ['responder', 'grupos', 'repetir']
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.pos.x is number && request.resource.data.pos.x >= -10 && request.resource.data.pos.x <= 10
          && request.resource.data.pos.y is number && request.resource.data.pos.y >= -10 && request.resource.data.pos.y <= 10
          && request.resource.data.campo is string && request.resource.data.campo.size() <= 40
          && request.resource.data.respuestas is map && request.resource.data.respuestas.size() <= 12
          && (!('repeticion' in request.resource.data)
              || (request.resource.data.repeticion.pos.x is number && request.resource.data.repeticion.pos.x >= -10 && request.resource.data.repeticion.pos.x <= 10
                  && request.resource.data.repeticion.pos.y is number && request.resource.data.repeticion.pos.y >= -10 && request.resource.data.repeticion.pos.y <= 10
                  && request.resource.data.repeticion.campo is string && request.resource.data.repeticion.campo.size() <= 40
                  && request.resource.data.repeticion.respuestas is map && request.resource.data.repeticion.respuestas.size() <= 12));
      }

      // El público activo (publico.js): termómetro, reacciones y preguntas de la tribuna. Solo quien
      // vota en el debate en curso (no los dos grupos que debaten), con el tramo abierto. El id
      // amarra el documento a su dueño: uno por persona y debate (o por persona y mensaje).
      match /termometro/{id} {
        allow read: if esProfe(codigo) || (conSesion() && id.matches('^[0-9]+_' + request.auth.uid + '$'));
        allow write: if conSesion() && esJugador(codigo)
          && id == string(request.resource.data.debate) + '_' + request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.debate == sala(codigo).data.debate.n
          && sala(codigo).data.fase == 'abierta'
          && jugador(codigo).data.grupo != sala(codigo).data.debate.A
          && jugador(codigo).data.grupo != sala(codigo).data.debate.B
          && request.resource.data.pos is number && request.resource.data.pos >= -100 && request.resource.data.pos <= 100
          && request.resource.data.pos0 is number && request.resource.data.pos0 >= -100 && request.resource.data.pos0 <= 100;
      }
      match /reacciones/{id} {
        allow read: if esProfe(codigo) || (conSesion() && esJugador(codigo));
        allow write: if conSesion() && esJugador(codigo)
          && request.resource.data.msg is string && request.resource.data.msg.size() <= 60
          && id == request.resource.data.msg + '_' + request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.debate == sala(codigo).data.debate.n
          && sala(codigo).data.fase == 'abierta'
          && jugador(codigo).data.grupo != sala(codigo).data.debate.A
          && jugador(codigo).data.grupo != sala(codigo).data.debate.B
          && (request.resource.data.r == null || request.resource.data.r in ['fuego', 'fuente', 'concede']);
      }
      match /preguntas/{id} {
        allow read: if esProfe(codigo) || (conSesion() && id.matches('^[0-9]+_' + request.auth.uid + '$'));
        allow write: if conSesion() && esJugador(codigo)
          && id == string(request.resource.data.debate) + '_' + request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.debate == sala(codigo).data.debate.n
          && sala(codigo).data.fase == 'abierta'
          && jugador(codigo).data.grupo != sala(codigo).data.debate.A
          && jugador(codigo).data.grupo != sala(codigo).data.debate.B
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 200
          // el nombre y el grupo son los del alumno: la moderadora la lanza con ese nombre
          && request.resource.data.nombre == jugador(codigo).data.nombre
          && request.resource.data.grupo == jugador(codigo).data.grupo;
      }

      // Rotación: el voto binario y la predicción de cada votante en cada debate. Solo en la
      // ventana de votación y solo quien no está debatiendo.
      match /votos/{id} {
        allow read: if esProfe(codigo) || (conSesion() && id.matches('^[0-9]+_' + request.auth.uid + '$'));
        allow write: if conSesion() && esJugador(codigo)
          && id == string(request.resource.data.debate) + '_' + request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.debate == sala(codigo).data.debate.n
          && sala(codigo).data.fase == 'votando'
          && jugador(codigo).data.grupo != sala(codigo).data.debate.A
          && jugador(codigo).data.grupo != sala(codigo).data.debate.B
          && (request.resource.data.voto == null || request.resource.data.voto in ['A', 'B'])
          && (request.resource.data.prediccion == null || request.resource.data.prediccion in ['A', 'B'])
          // el nombre y el grupo son los del alumno (se ven en el ranking de oráculos)
          && request.resource.data.nombre == jugador(codigo).data.nombre
          && request.resource.data.grupo == jugador(codigo).data.grupo;
      }
    }
  }
}
